# Copy to terraform.tfvars and fill in (terraform.tfvars is NEVER committed).
# Alternative: export as environment variables, e.g. export TF_VAR_hcloud_token=...

hcloud_token         = "<hetzner-token>"
cloudflare_api_token = "<cloudflare-token>"
cloudflare_zone_id   = "<domain-zone-id>"

admin_ip = "<your-public-ip>" # e.g. 203.0.113.10

# Optional (defaults in variables.tf):
# server_type = "cx22"
# server_location = "nbg1"
