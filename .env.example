# HoraAmiga - Template de variaveis de ambiente
# Copie para .env e preencha com os valores reais (o .env NUNCA e versionado).

# --- Aplicacao ---
NODE_ENV=production
PORT=3000

# --- Banco de dados (Supabase / PostgreSQL) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<chave-publica-anon>
SUPABASE_SERVICE_ROLE_KEY=<chave-de-servico-privada>
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>

# --- Autenticacao ---
JWT_SECRET=<gerar-string-aleatoria-forte>
API_KEY=<gerar-string-aleatoria-forte>

# --- Notificacoes (Telegram) ---
TELEGRAM_BOT_TOKEN=<token-do-botfather>
TELEGRAM_CHAT_ID=<id-do-grupo>

# --- Email (Resend) ---
RESEND_API_KEY=<chave-resend>
