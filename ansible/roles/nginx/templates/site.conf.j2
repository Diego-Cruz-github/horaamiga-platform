# Nginx template (Jinja2). {{ }} variables are filled in by Ansible.
# Base/sanitized version of the real config - structure over secrets.
#
# The platform serves TWO frontends from the same server:
#   - Institutional website -> {{ domain }} (static, trilingual PT/EN/ES)
#   - Application (PWA+API) -> {{ app_subdomain }}.{{ domain }} (static PWA + /api to Node)
#
# Bootstrap note (chicken-and-egg): these blocks listen on port 80 only, so the
# config is valid BEFORE any certificate exists. The certbot role then runs
# "certbot --nginx", which adds the 443/SSL blocks and the HTTP->HTTPS redirect
# automatically. Editing this template later does not remove the certbot blocks.

# --- Institutional website ({{ domain }}) ---
server {
    listen 80;
    server_name {{ domain }} www.{{ domain }};

    # Basic security headers.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Static website content (HTML/CSS/JS, no framework).
    root /var/www/horaamiga/site;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
}

# --- Application: PWA + API ({{ app_subdomain }}.{{ domain }}) ---
server {
    listen 80;
    server_name {{ app_subdomain }}.{{ domain }};

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # PWA static assets (Service Worker, manifest, etc).
    root /var/www/horaamiga/app;
    index index.html;

    # SPA/PWA: frontend routes fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API forwarded to Node (PM2 listening locally on 3000).
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
